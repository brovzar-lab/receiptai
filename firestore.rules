rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /expenses/{expenseId} {
        allow read, write: if isOwner(uid);
      }

      match /mileage/{logId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /profiles/{uid} {
      allow read, write: if isOwner(uid);
    }
  }
}
